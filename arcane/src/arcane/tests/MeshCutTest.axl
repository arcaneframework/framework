<?xml version="1.0" ?>
<module name="MeshCutTest" version="1.0" namespace-name="ArcaneTest">
<description>
  Test module
</description>

  <variables>
    <variable
      field-name="on_cells0"
      name="OnCells0"
      data-type="real"
      item-kind="cell"
      dim="0"
      dump="true"
      need-sync="true"/>

    <variable
      field-name="on_cells1"
      name="OnCells1"
      data-type="real"
      item-kind="cell"
      dim="1"
      dump="true"
      need-sync="true"/>
  </variables>

<entry-points>
  <entry-point method-name="compute" name="Compute" where="compute-loop" property="none"/>
</entry-points>

<options>
  <simple name="enable-post-processing" type="bool" default="false">
  </simple>
  <complex name="plane" type="Plane" minOccurs="0" maxOccurs="unbounded">
    <simple name="p0" type="real3">
    </simple>
    <simple name="p0-velocity" type="real3" default="0 0 0">
    </simple>
    <simple name="normal" type="real3">
    </simple>
  </complex>
</options>
</module>
