<?xml version="1.0" ?>
<!-- Description of the 'HllcScheme' module -->
<module name="HllcScheme" version="1.0" namespace-name="ArcaneTest::HllcScheme">
  <variables>
    <!-- DENSITY -->
    <variable
      field-name="density"
      name="Density"
      data-type="real"
      item-kind="cell"
      dim="0"
      dump="true"
      need-sync="true"/>
    <!-- MOMENTUM -->
    <variable
      field-name="momentum"
      name="Momentum"
      data-type="real3"
      item-kind="cell"
      dim="0"
      dump="true"
      need-sync="true"/>
    <!-- TOTAL ENERGY -->
    <variable
      field-name="energy"
      name="Energy"
      data-type="real"
      item-kind="cell"
      dim="0"
      dump="true"
      need-sync="true"/>
    <!-- NEW DENSITY (temporary buffer for the thread-parallel update) -->
    <variable
      field-name="new_density"
      name="NewDensity"
      data-type="real"
      item-kind="cell"
      dim="0"
      dump="false"
      need-sync="false"/>
    <!-- NEW MOMENTUM (temporary buffer for the thread-parallel update) -->
    <variable
      field-name="new_momentum"
      name="NewMomentum"
      data-type="real3"
      item-kind="cell"
      dim="0"
      dump="false"
      need-sync="false"/>
    <!-- NEW ENERGY (temporary buffer for the thread-parallel update) -->
    <variable
      field-name="new_energy"
      name="NewEnergy"
      data-type="real"
      item-kind="cell"
      dim="0"
      dump="false"
      need-sync="false"/>
    <!-- PRESSURE -->
    <variable
      field-name="pressure"
      name="Pressure"
      data-type="real"
      item-kind="cell"
      dim="0"
      dump="true"
      need-sync="true"/>
    <!-- CELL VOLUME -->
    <variable
      field-name="cell_volume"
      name="CellVolume"
      data-type="real"
      item-kind="cell"
      dim="0"
      dump="true"
      need-sync="false"/>
    <!-- CELL MASS -->
    <variable
      field-name="cell_mass"
      name="CellMass"
      data-type="real"
      item-kind="cell"
      dim="0"
      dump="true"
      need-sync="false"/>
    <!-- SOUND SPEED -->
    <variable
      field-name="sound_speed"
      name="SoundSpeed"
      data-type="real"
      item-kind="cell"
      dim="0"
      dump="true"
      need-sync="true"/>
    <!-- CELL IS SOLID -->
    <variable
      field-name="cell_is_solid"
      name="CellIsSolid"
      data-type="integer"
      item-kind="cell"
      dim="0"
      dump="true"
      need-sync="false"/>
    <!-- FACE NORMAL -->
    <variable
      field-name="face_normal"
      name="FaceNormal"
      data-type="real3"
      item-kind="face"
      dim="0"
      dump="true"
      need-sync="false"/>
    <!-- FACE AREA -->
    <variable
      field-name="face_area"
      name="FaceArea"
      data-type="real"
      item-kind="face"
      dim="0"
      dump="true"
      need-sync="false"/>
    <!-- CENTER -->
    <variable
      field-name="cell_center"
      name="CellCenter"
      data-type="real3"
      item-kind="cell"
      dim="0"
      dump="true"
      need-sync="false"/>
    <!-- FACE CENTER -->
    <variable
      field-name="face_center"
      name="FaceCenter"
      data-type="real3"
      item-kind="face"
      dim="0"
      dump="true"
      need-sync="false"/>
    <!-- NODE COORD -->
    <variable
      field-name="node_coord"
      name="NodeCoord"
      data-type="real3"
      item-kind="node"
      dim="0"
      dump="true"
      need-sync="true"/>
    <!-- FACE BC TYPE -->
    <variable
      field-name="face_bc_type"
      name="FaceBcType"
      data-type="integer"
      item-kind="face"
      dim="0"
      dump="true"
      need-sync="false"/>
    <!-- FACE BC INFLOW DENSITY -->
    <variable
      field-name="face_bc_density"
      name="FaceBcDensity"
      data-type="real"
      item-kind="face"
      dim="0"
      dump="true"
      need-sync="false"/>
    <!-- FACE BC INFLOW VELOCITY -->
    <variable
      field-name="face_bc_velocity"
      name="FaceBcVelocity"
      data-type="real3"
      item-kind="face"
      dim="0"
      dump="true"
      need-sync="false"/>
    <!-- FACE BC INFLOW PRESSURE -->
    <variable
      field-name="face_bc_pressure"
      name="FaceBcPressure"
      data-type="real"
      item-kind="face"
      dim="0"
      dump="true"
      need-sync="false"/>
  </variables>

  <entry-points>
    <entry-point method-name="build" name="HLLC_Build" where="build" property="none"/>
    <entry-point method-name="init" name="HLLC_Init" where="init" property="none"/>
    <entry-point method-name="computeLoop" name="HLLC_ComputeLoop" where="compute-loop" property="none"/>
    <entry-point method-name="exit" name="HLLC_Exit" where="exit" property="none"/>
  </entry-points>

  <options>
    <!-- CFL -->
    <simple
      name="cfl"
      type="real"
      default="0.5">
      <description>
        Courant-Friedrichs-Lewy number for the time step.
      </description>
    </simple>

    <!-- FINAL TIME -->
    <simple
      name="final-time"
      type="real"
      default="1.0">
      <description>
        Final simulation time.
      </description>
    </simple>

    <!-- GAMMA -->
    <simple
      name="gamma"
      type="real"
      default="1.4">
      <description>
        Adiabatic coefficient (ratio of specific heats).
      </description>
    </simple>

    <!-- DELTAT INIT -->
    <simple
      name="deltat-init"
      type="real"
      default="1.0e-4">
      <description>
        Initial time step.
      </description>
    </simple>

    <!-- LIMITER -->
    <enumeration
      name="limiter"
      type="ArcaneTest::HllcScheme::TypesHllcScheme::eLimiter"
      default="VanLeer">
      <description>
        Limiter for MUSCL reconstruction.
      </description>
      <enumvalue genvalue="ArcaneTest::HllcScheme::TypesHllcScheme::MinMod" name="MinMod"/>
      <enumvalue genvalue="ArcaneTest::HllcScheme::TypesHllcScheme::VanLeer" name="VanLeer"/>
      <enumvalue genvalue="ArcaneTest::HllcScheme::TypesHllcScheme::VanAlbada" name="VanAlbada"/>
      <enumvalue genvalue="ArcaneTest::HllcScheme::TypesHllcScheme::Superbee" name="Superbee"/>
    </enumeration>

    <!-- ORDER -->
    <simple
      name="spatial-order"
      type="int32"
      default="2">
      <description>
        Spatial order (1 = first order, 2 = MUSCL second order).
      </description>
    </simple>

    <!-- INITIAL CONDITION -->
    <enumeration
      name="initial-condition"
      type="ArcaneTest::HllcScheme::TypesHllcScheme::eInitialCondition"
      default="Sod">
      <description>
        Type of the initial condition.
      </description>
      <enumvalue genvalue="ArcaneTest::HllcScheme::TypesHllcScheme::Sod" name="Sod"/>
      <enumvalue genvalue="ArcaneTest::HllcScheme::TypesHllcScheme::Uniform" name="Uniform"/>
    </enumeration>

    <!-- UNIFORM DENSITY -->
    <simple
      name="uniform-density"
      type="real"
      default="1.0">
      <description>
        Density of the uniform initial condition.
      </description>
    </simple>

    <!-- UNIFORM PRESSURE -->
    <simple
      name="uniform-pressure"
      type="real"
      default="1.0">
      <description>
        Pressure of the uniform initial condition.
      </description>
    </simple>

    <!-- UNIFORM VELOCITY X -->
    <simple
      name="uniform-velocity-x"
      type="real"
      default="0.0">
      <description>
        X-component of the velocity of the uniform initial condition.
      </description>
    </simple>

    <!-- UNIFORM VELOCITY Y -->
    <simple
      name="uniform-velocity-y"
      type="real"
      default="0.0">
      <description>
        Y-component of the velocity of the uniform initial condition.
      </description>
    </simple>

    <!-- UNIFORM VELOCITY Z -->
    <simple
      name="uniform-velocity-z"
      type="real"
      default="0.0">
      <description>
        Z-component of the velocity of the uniform initial condition.
      </description>
    </simple>

    <!-- SOLID OBSTACLE RADIUS -->
    <simple
      name="obstacle-radius"
      type="real"
      default="0.0">
      <description>
        Radius of the solid obstacle (circle in 2D, sphere in 3D)
        immersed in the fluid. No obstacle if the radius is zero or negative.
      </description>
    </simple>

    <!-- SOLID OBSTACLE X -->
    <simple
      name="obstacle-x"
      type="real"
      default="0.5">
      <description>
        X position of the center of the solid obstacle.
      </description>
    </simple>

    <!-- SOLID OBSTACLE Y -->
    <simple
      name="obstacle-y"
      type="real"
      default="0.5">
      <description>
        Y position of the center of the solid obstacle.
      </description>
    </simple>

    <!-- SOLID OBSTACLE Z -->
    <simple
      name="obstacle-z"
      type="real"
      default="0.5">
      <description>
        Z position of the center of the solid obstacle (3D only).
      </description>
    </simple>

    <!-- BOUNDARY CONDITION -->
    <complex name="boundary-condition" type="BoundaryCondition"
             minOccurs="0" maxOccurs="unbounded">
      <description>Boundary condition specification</description>
      <enumeration name="type" type="ArcaneTest::HllcScheme::TypesHllcScheme::eBoundaryCondition">
        <enumvalue genvalue="ArcaneTest::HllcScheme::TypesHllcScheme::Wall" name="Wall"/>
        <enumvalue genvalue="ArcaneTest::HllcScheme::TypesHllcScheme::Inflow" name="Inflow"/>
        <enumvalue genvalue="ArcaneTest::HllcScheme::TypesHllcScheme::Outflow" name="Outflow"/>
      </enumeration>
      <extended name="surface" type="Arcane::FaceGroup">
        Surface on which BC applies
      </extended>
      <simple name="density" type="real" default="1.0">
        Imposed density (inflow only)
      </simple>
      <simple name="velocity-x" type="real" default="0.0">
        Imposed velocity x-component (inflow only)
      </simple>
      <simple name="velocity-y" type="real" default="0.0">
        Imposed velocity y-component (inflow only)
      </simple>
      <simple name="velocity-z" type="real" default="0.0">
        Imposed velocity z-component (inflow only)
      </simple>
      <simple name="pressure" type="real" default="1.0">
        Imposed pressure (inflow only)
      </simple>
    </complex>

    <!-- VALIDATION -->
    <complex name="validation" type="Validation" optional="true">
      <description>
        Optional validation of the global sums computed in the exit()
        entry point. Each expected value is only checked if the
        corresponding element is present in the case file.
      </description>
      <simple name="density-sum" type="real" default="0.0">
        Expected value of the sum of the densities (all the cells).
      </simple>
      <simple name="energy-sum" type="real" default="0.0">
        Expected value of the sum of the total energies (all the cells).
      </simple>
      <simple name="pressure-sum" type="real" default="0.0">
        Expected value of the sum of the pressures (all the cells).
      </simple>
      <simple name="epsilon" type="real" default="1.0e-6">
        Tolerance for the comparisons.
      </simple>
    </complex>
  </options>

</module>
