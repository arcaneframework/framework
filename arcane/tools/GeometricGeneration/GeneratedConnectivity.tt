<#@ template language="C#" linePragmas="false" #>
/*
 * Generation of classes allowing retrieval of connectivity information
 * for each type of geometric element.
 */
<# foreach( Item item in Connectivity.Items ) { #>
/*!
 * \ingroup ArcaneGeometric
 * \brief Connectivity information for geometric elements of type GeomType::<#=item.Name #>.
<# if (item.Type==GeomType.Pyramid5) { #>
 *
 * \note the pyramid has 8 edges but it is considered a degenerate hexahedron
 * at the pyramid's apex. To account for this, we indicate
 * that it has 12 edges.
<# } #>
 */
class ARCANE_GEOMETRY_EXPORT <#=item.Name#>Connectivity
: public CellConnectivity
{
 public:

  <#=item.Name#>Connectivity()
  : CellConnectivity(<#=item.NbNode#>,<#=item.NbEdge#>,<#=item.NbFace#>,GeomType::<#=item.Type#>)
  {
    _init();
  }

 public:

  constexpr Int32 nbNode() const { return <#=item.NbNode#>; }
  constexpr Int32 nbEdge() const { return <#=item.NbEdge#>; }
  constexpr Int32 nbFace() const { return <#=item.NbFace#>; }

 private:

  void _init();
};
<# } #>   
   
