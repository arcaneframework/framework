<#@ template language="C#" linePragmas="false" #>
/*
 * Génération des classes des vues sur les éléments géométriques (GeomElement).
 */
<# foreach( Item item in Connectivity.Items2DAnd3D ) { #>

/*!
 * \ingroup ArcaneGeometric
 * \brief Constant view on geometric elements of type  GeomType::<#=item.Name#>.
 * 
 * It is possible to retrieve a view of this type via:
 * - directly from an instance of Triangle3ShapeView.
 * - directly from an instance of Triangle3Element
 * - an instance of Triangle3ElementView via Triangle3ElementView::constView()
 * - an instance of GeomShapeView via GeomShapeView::toTriangle3Element()
 *
 * For more information on usage, refer to \ref arcanedoc_cea_geometric_viewusage.
 */
class ARCANE_GEOMETRY_EXPORT <#=item.Name#>ElementConstView
: public GeomElementConstViewBase
{
 public:

  constexpr <#=item.Name#>ElementConstView(ARCANE_RESTRICT const Real3POD* ptr)
  : GeomElementConstViewBase(ptr){}
};

/*!
 * \ingroup ArcaneGeometric
 * \brief Modifiable view on geometric elements of type GeomType::<#=item.Name#>.
 * 
 * It is possible to retrieve a view of this type via:
 * - directly from an instance of Triangle3Element
 * - an instance of Triangle3Element via Triangle3ElementView::view()
 *
 * For more information on usage, refer to \ref arcanedoc_cea_geometric_viewusage.
 */
class ARCANE_GEOMETRY_EXPORT <#=item.Name#>ElementView
: public GeomElementViewBase
{
 public:

  using ConstViewType = <#=item.Name#>ElementConstView;

 public:

  //! Construct a view from the coordinates passed as arguments
  constexpr <#=item.Name#>ElementView(ARCANE_RESTRICT Real3POD* ptr)
  : GeomElementViewBase(ptr){}
  //! Initializes the view with the coordinates passed as arguments
  constexpr void init(<#=item.CoordsArgString()#>)
  {
   <# for( int i=0; i<item.NbNode; ++i ) { #>
   m_s[<#=i#>] = a<#=i#>;
   <# } #>
  }
  //! Conversion operator to a constant view
  constexpr operator <#=item.Name#>ElementConstView() const { return ConstViewType(m_s); }
  //! Constant view on the element
  constexpr <#=item.Name#>ElementConstView constView() const { return ConstViewType(m_s); }
};

<# // Génère un typedef s'il existe un nom court #>
<# if (item.BasicName != item.Name ) { #>
//! View on an element of type GeomType::<#=item.Name#>
using <#=item.BasicName#>ElementView = <#=item.Name#>ElementView ;
//! Constant view on an element of type GeomType::<#=item.Name#>
using <#=item.BasicName#>ElementConstView = <#=item.Name#>ElementConstView ;
<# } #>

<# } #>